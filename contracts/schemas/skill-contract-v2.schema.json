{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skill-evolution:schema:skill-contract:v2",
  "title": "Skill Contract v2",
  "description": "Accepted thin binding contract for Skill identity, runtime policy, approval, and evaluation-suite references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "skill_id",
    "version",
    "status",
    "owner",
    "approved_by",
    "approved_at",
    "supersedes",
    "runtime",
    "evaluation"
  ],
  "properties": {
    "schema": {
      "const": "skill.contract.v2"
    },
    "skill_id": {
      "$ref": "#/$defs/id"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "proposed",
        "approved"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "supersedes": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/predecessor"
        }
      ]
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "evaluation": {
      "$ref": "#/$defs/evaluation"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approved_by": {
            "type": "string",
            "minLength": 1
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "else": {
        "properties": {
          "approved_by": {
            "type": "null"
          },
          "approved_at": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "stringSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
      }
    },
    "nonEmptyStringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
      }
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "version",
        "path"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_tools",
        "allowed_tools",
        "allowed_permissions",
        "network",
        "credentials_in_sandbox",
        "dependencies",
        "assets"
      ],
      "properties": {
        "required_tools": {
          "$ref": "#/$defs/nonEmptyStringSet"
        },
        "allowed_tools": {
          "$ref": "#/$defs/nonEmptyStringSet"
        },
        "allowed_permissions": {
          "$ref": "#/$defs/nonEmptyStringSet"
        },
        "network": {
          "enum": [
            "forbidden",
            "explicit_approval_required",
            "allowed"
          ]
        },
        "credentials_in_sandbox": {
          "type": "boolean"
        },
        "dependencies": {
          "$ref": "#/$defs/stringSet"
        },
        "assets": {
          "$ref": "#/$defs/stringSet"
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite_refs"
      ],
      "properties": {
        "suite_refs": {
          "$ref": "#/$defs/nonEmptyStringSet"
        }
      }
    }
  }
}
